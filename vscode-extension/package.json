{
	"name": "fpga-tools",
	"displayName": "FPGA Tools",
	"description": "Buttons to simulate, build and program FPGA designs with the Vivado container from vivado-on-silicon-mac",
	"version": "0.1.0",
	"publisher": "techno453",
	"repository": {
		"type": "git",
		"url": "https://github.com/Techno453/vivado-on-silicon-mac"
	},
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"Other"
	],
	"main": "./extension.js",
	"activationEvents": [
		"workspaceContains:**/*.{vhd,vhdl,v,sv,xpr}",
		"onView:fpgaTools.actions"
	],
	"contributes": {
		"configuration": {
			"title": "FPGA Tools",
			"properties": {
				"fpgaTools.toolsFolder": {
					"type": "string",
					"default": "~/Desktop/vivado-on-silicon-mac",
					"description": "Folder of vivado-on-silicon-mac, which contains bin/fpga."
				},
				"fpgaTools.part": {
					"type": "string",
					"default": "",
					"description": "FPGA part for builds without a Vivado project. Empty uses xc7z010clg400-1."
				},
				"fpgaTools.autoStopMinutes": {
					"type": "number",
					"default": 10,
					"minimum": 0,
					"description": "Stop the Vivado container after this many idle minutes (no FPGA action and no container running). 0 keeps it running."
				}
			}
		},
		"commands": [
			{
				"command": "fpgaTools.simulate",
				"title": "Simulate Testbench",
				"category": "FPGA",
				"icon": "$(play)"
			},
			{
				"command": "fpgaTools.build",
				"title": "Build Bitstream",
				"category": "FPGA",
				"icon": "$(tools)"
			},
			{
				"command": "fpgaTools.program",
				"title": "Program Board",
				"category": "FPGA",
				"icon": "$(zap)"
			},
			{
				"command": "fpgaTools.openWaveform",
				"title": "Open Last Waveform",
				"category": "FPGA",
				"icon": "$(pulse)"
			},
			{
				"command": "fpgaTools.openGui",
				"title": "Open Vivado GUI",
				"category": "FPGA",
				"icon": "$(window)"
			},
			{
				"command": "fpgaTools.init",
				"title": "Set Up Project Folder",
				"category": "FPGA",
				"icon": "$(gear)"
			},
			{
				"command": "fpgaTools.startContainer",
				"title": "Start Container",
				"category": "FPGA",
				"icon": "$(vm-outline)"
			},
			{
				"command": "fpgaTools.stopContainer",
				"title": "Stop Container",
				"category": "FPGA",
				"icon": "$(vm-running)"
			},
			{
				"command": "fpgaTools.toggleContainer",
				"title": "Start or Stop Container",
				"category": "FPGA"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "fpgaTools.simulate",
					"when": "resourceExtname =~ /^\\.(vhdl?|s?v)$/",
					"group": "navigation"
				}
			]
		},
		"keybindings": [
			{
				"command": "fpgaTools.simulate",
				"key": "ctrl+alt+s"
			},
			{
				"command": "fpgaTools.build",
				"key": "ctrl+alt+b"
			},
			{
				"command": "fpgaTools.program",
				"key": "ctrl+alt+p"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "fpgaTools",
					"title": "FPGA",
					"icon": "media/chip.svg"
				}
			]
		},
		"views": {
			"fpgaTools": [
				{
					"id": "fpgaTools.actions",
					"name": "Actions"
				}
			]
		},
		"taskDefinitions": [
			{
				"type": "fpgaTools",
				"required": [
					"action"
				],
				"properties": {
					"action": {
						"type": "string",
						"description": "The fpga command to run"
					}
				}
			}
		],
		"problemMatchers": [
			{
				"name": "vivado",
				"owner": "vivado",
				"fileLocation": "absolute",
				"pattern": {
					"regexp": "^(ERROR|WARNING): \\[([^\\]]+)\\] (.*) \\[(.+):(\\d+)\\]$",
					"severity": 1,
					"code": 2,
					"message": 3,
					"file": 4,
					"line": 5
				}
			},
			{
				"name": "vivado-critical",
				"owner": "vivado",
				"fileLocation": "absolute",
				"severity": "warning",
				"pattern": {
					"regexp": "^CRITICAL WARNING: \\[([^\\]]+)\\] (.*) \\[(.+):(\\d+)\\]$",
					"code": 1,
					"message": 2,
					"file": 3,
					"line": 4
				}
			}
		]
	}
}
